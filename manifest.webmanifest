{
  "id": "/",
  "name": "Talendus",
  "short_name": "Talendus",
  "description": "Agence de placement Talendus : offres, espace candidat et espace employeur sur le site.",
  "start_url": "/emplois.html",
  "scope": "/",
  "display": "browser",
  "orientation": "any",
  "background_color": "#0b1f3a",
  "theme_color": "#0b1f3a",
  "lang": "fr-CA",
  "dir": "ltr",
  "categories": ["business"],
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://talendus.ca/manifest.webmanifest"
    }
  ],
  "icons": [
    {
      "src": "/assets/img/logo/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/img/logo/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/img/logo/icon-192-maskable.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/assets/img/logo/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Offres · Jobs",
      "short_name": "Jobs",
      "url": "/emplois.html",
      "icons": [{ "src": "/assets/img/logo/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Espace",
      "short_name": "Espace",
      "url": "/espace.html",
      "icons": [{ "src": "/assets/img/logo/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
