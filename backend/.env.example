# Talendus API — copier vers .env et adapter.
# Ne jamais committer de secrets réels.

APP_NAME=Talendus API
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET=change-me-to-another-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=14

DATABASE_URL=sqlite:///./data/talendus.db
# Production (PostgreSQL) :
# DATABASE_URL=postgresql+psycopg://talendus:CHANGE_ME@localhost:5432/talendus

ADMIN_EMAIL=lea.super@talendus.ca
# Production : mot de passe fort (min. 12 caractères), jamais « talendus ».
ADMIN_PASSWORD=

FRONTEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000

EMAIL_ENABLED=false
EMAIL_SERVER=smtp.example.com
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=Talendus <noreply@talendus.ca>
EMAIL_USE_TLS=true

STORAGE_DIR=./storage
STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=ca-central-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PREFIX=talendus
MAX_RESUME_MB=5

JOB_MATCH_MIN_SCORE=50
RATE_LIMIT_PER_MINUTE=80
SEED_PASSWORD=talendus
DEFAULT_CURRENCY=CAD
DEFAULT_TAX_RATE_BP=14975

INTEGRATIONS_TIMEOUT_SECONDS=15
INTEGRATIONS_MAX_RETRIES=2

# Job boards (API partenaires uniquement — jamais de scraping)
LINKEDIN_ENABLED=false
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_BASE_URL=https://api.linkedin.com

INDEED_ENABLED=false
INDEED_PUBLISHER_ID=
INDEED_API_KEY=
INDEED_API_BASE_URL=https://apis.indeed.com

# WhatsApp Business Cloud API
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v21.0

GOOGLE_OAUTH_CLIENT_ID=
LINKEDIN_OAUTH_CLIENT_ID=
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Contact public (remplace le 514 555-0199 de démonstration)
PUBLIC_PHONE_E164=15145550199
PUBLIC_PHONE_DISPLAY=514 555-0199
PUBLIC_EMAIL=info@talendus.ca

GOOGLE_MAPS_ENABLED=false
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_BASE_URL=https://maps.googleapis.com/maps/api

# Stripe (checkout factures) — false tant que les clés ne sont pas dans Render
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# PayPal
PAYPAL_ENABLED=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com

# OpenAI (jamais exposé au front, jamais appelé automatiquement)
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_BASE_URL=https://api.openai.com/v1

# Signature électronique tierce (distincte de la signature interne SHA-256)
ESIGNATURE_ENABLED=false
ESIGNATURE_PROVIDER=docusign
ESIGNATURE_API_KEY=
ESIGNATURE_API_BASE_URL=
ESIGNATURE_WEBHOOK_SECRET=

# Mesure marketing (jamais hardcodé dans le HTML)
# TRACKING_ENABLED=false tant que le consentement n'est pas prêt en production.
TRACKING_ENABLED=false
GA_MEASUREMENT_ID=
META_PIXEL_ID=
SEO_CANONICAL_HOST=https://talendus.ca
# Jeton Search Console (méthode fichier HTML : /googleJETON.html + balise meta si pages régénérées)
GOOGLE_SITE_VERIFICATION=

# Web Push (VAPID). Laisser vide : les clés sont générées et stockées en base.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_MAILTO=mailto:ivan.p@example.net
